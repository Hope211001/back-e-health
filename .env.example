# Modèle de configuration du backend Mediora.
# Copier en .env et renseigner les valeurs. Ne JAMAIS committer le .env réel.

PORT=5000
NODE_ENV=development

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Coller la clé entre guillemets, avec les \n littéraux.
FIREBASE_PRIVATE_KEY=

# --- Cloudinary ---
# Deux usages, tous deux en upload SIGNÉ depuis le backend
# (src/services/cloudinaryService.js), d'où le besoin de l'API secret ici :
#   - photos de profil (data URI envoyée par l'application) ;
#   - affiches de pharmacies de garde (ré-hébergement d'une URL Facebook, dont
#     le lien d'origine expire au bout de quelques jours).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier de destination des photos de profil (défaut : mediora/photos-profil)
CLOUDINARY_DOSSIER_PHOTOS=

# --- Envoi d'emails (nodemailer) ---
# Sert à transmettre son mot de passe à un compte créé par un administrateur ou
# par un médecin, et à acheminer les liens de réinitialisation.
#
# Pourquoi pas Firebase : l'AUTHENTIFICATION reste chez Firebase Auth (mots de
# passe, connexion Google, tokens). Mais son service d'ENVOI d'emails a un
# catalogue fermé — pas de message « voici vos identifiants » —, des gabarits
# figés, un expéditeur imposé et un quota non paramétrable.
#
# Réglages génériques et non liés à un fournisseur : passer de Gmail à Brevo ou
# à un SMTP d'établissement ne demande que de changer ces valeurs.
#
# Gmail : activer la validation en deux étapes sur le compte, puis créer un
#   « mot de passe d'application » — https://myaccount.google.com/apppasswords
#   Le mot de passe habituel du compte Google est REFUSÉ par le SMTP.
#   Environ 500 destinataires par jour, largement suffisant ici.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# true uniquement avec MAIL_PORT=465 (TLS dès la connexion). Le port 587 démarre
# en clair puis bascule via STARTTLS. Laisser vide pour déduire depuis le port.
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

# Expéditeur affiché. Beaucoup de serveurs refusent une adresse différente du
# compte authentifié — dans le doute, reprendre celle de MAIL_USER.
MAIL_FROM="Mediora <exemple@gmail.com>"

# Lien « Ouvrir Mediora » ajouté au bas de l'email (optionnel).
# Laisser vide tant qu'aucun lien de téléchargement n'est publié : le bouton
# disparaît alors du message au lieu de pointer vers le vide.
MAIL_URL_APP=

# true → aucun envoi réel, le message est affiché dans la console du serveur.
# À utiliser en développement et pour les démonstrations hors ligne : sans lui,
# chaque test de création de compte écrit à une vraie adresse.
MAIL_DESACTIVE=false

# --- OCR et tri des publications (OpenRouter) ---
# Une seule clé pour les deux usages : la lecture des affiches (modèle vision)
# et le tri des publications Facebook (modèle texte).
# Clé : https://openrouter.ai/keys   (obligatoire, sinon erreur explicite)
OPENROUTER_API_KEY=

# Modèles, du préféré au repli, séparés par des virgules. OpenRouter bascule
# automatiquement sur le suivant quand le premier est saturé (429 upstream) —
# fréquent sur les modèles `:free`, partagés entre tous les comptes.
# Le catalogue gratuit ÉVOLUE : si tous renvoient « model not found », lister
# les modèles réellement disponibles avec
#   GET https://openrouter.ai/api/v1/models   (filtrer les id finissant par :free)
# Vision (lecture des affiches) :
# Trois FOURNISSEURS distincts (3 maximum, l'API refuse au-dela) : gemma-31b
# et gemma-26b partageraient le pool Google AI Studio et satureraient ensemble.
OPENROUTER_MODELES_VISION=google/gemma-4-26b-a4b-it:free, dots-studio/dots-3-note-preview:free, minimax/minimax-m3:free
# Texte (tri des publications) :
OPENROUTER_MODELES_TEXTE=google/gemma-4-26b-a4b-it:free, minimax/minimax-m3:free, z-ai/glm-5.2:free

# Palier gratuit OpenRouter : 20 requêtes/minute et 50 par JOUR (1000 si au
# moins 10 $ de crédits ont été achetés une fois — les modèles :free ne les
# consomment pas). Une image analysée = une requête, donc une publication de
# 3 affiches en coûte 3.

# Plafond de tokens par réponse. En dessous de ~4000, la lecture d'une affiche
# dense est coupée en cours de liste et les dernières villes disparaissent.
OPENROUTER_MAX_TOKENS=4000

# Réessais après un 429 (en plus de la tentative initiale).
OPENROUTER_MAX_REESSAIS=2

# En-têtes de classement OpenRouter (facultatifs, sans effet sur le résultat).
OPENROUTER_SITE_URL=https://mediora.mg
OPENROUTER_SITE_NOM=Mediora

# Images analysées au plus par publication.
OCR_MAX_IMAGES=5

# Prompt OCR. Laisser VIDE pour utiliser src/prompts/ocr-pharmacie-garde.txt
# (recommandé : pas d'échappement à gérer, et relu à chaque analyse).
OCR_PROMPT=
# Chemin d'un autre fichier de prompt, relatif à back-e-health/ (optionnel).
OCR_PROMPT_FILE=
# Idem pour le prompt de tri (défaut : src/prompts/classification-post.txt).
CLASSIFICATION_PROMPT_FILE=

# --- Scraping des publications Facebook (Apify) ---
# Jeton : https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Actor officiel « Facebook Posts Scraper ». Seul lui renvoie les URLs d'images
# directes (media[].image.uri) : Facebook bloque tout autre accès serveur aux
# photos, et l'actor scraper_one ne donne que des liens de page.
APIFY_ACTOR_ID=KoJrdxJCTtpon81KY

# Page scrapée quand l'appelant n'en précise aucune.
APIFY_PAGE_DEFAUT=https://www.facebook.com/pharmacie.madagascar/

# Plafond d'exécution transmis à Apify, en secondes.
APIFY_TIMEOUT_S=300

# Import automatique, en jours (7 = une fois par semaine).
# Laisser VIDE ou à 0 pour n'importer que sur demande depuis l'application :
# chaque passage consomme du crédit Apify.
SCRAPING_INTERVAL_JOURS=

# Dossier Cloudinary des affiches ré-hébergées (défaut : pharmacie-garde).
CLOUDINARY_DOSSIER_AFFICHES=pharmacie-garde
