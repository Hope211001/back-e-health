# Modèle de configuration du backend Mediora.
# Copier en .env et renseigner les valeurs. Ne JAMAIS committer le .env réel.

PORT=5000
NODE_ENV=development

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Coller la clé entre guillemets, avec les \n littéraux.
FIREBASE_PRIVATE_KEY=

# --- Cloudinary ---
# Deux usages distincts :
#   - affiches de pharmacies de garde : uploadées par le workflow n8n avec un
#     preset non signé, le backend n'intervient pas ;
#   - photos de profil : uploadées par le backend (src/services/cloudinaryService.js)
#     en upload SIGNÉ, d'où le besoin de l'API secret ici. Ces trois variables
#     sont donc bien requises.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier de destination des photos de profil (défaut : mediora/photos-profil)
CLOUDINARY_DOSSIER_PHOTOS=

# --- Envoi d'emails (nodemailer) ---
# Sert à transmettre son mot de passe à un compte créé par un administrateur ou
# par un médecin, et à acheminer les liens de réinitialisation.
#
# Pourquoi pas Firebase : l'AUTHENTIFICATION reste chez Firebase Auth (mots de
# passe, connexion Google, tokens). Mais son service d'ENVOI d'emails a un
# catalogue fermé — pas de message « voici vos identifiants » —, des gabarits
# figés, un expéditeur imposé et un quota non paramétrable.
#
# Réglages génériques et non liés à un fournisseur : passer de Gmail à Brevo ou
# à un SMTP d'établissement ne demande que de changer ces valeurs.
#
# Gmail : activer la validation en deux étapes sur le compte, puis créer un
#   « mot de passe d'application » — https://myaccount.google.com/apppasswords
#   Le mot de passe habituel du compte Google est REFUSÉ par le SMTP.
#   Environ 500 destinataires par jour, largement suffisant ici.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# true uniquement avec MAIL_PORT=465 (TLS dès la connexion). Le port 587 démarre
# en clair puis bascule via STARTTLS. Laisser vide pour déduire depuis le port.
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

# Expéditeur affiché. Beaucoup de serveurs refusent une adresse différente du
# compte authentifié — dans le doute, reprendre celle de MAIL_USER.
MAIL_FROM="Mediora <exemple@gmail.com>"

# Lien « Ouvrir Mediora » ajouté au bas de l'email (optionnel).
# Laisser vide tant qu'aucun lien de téléchargement n'est publié : le bouton
# disparaît alors du message au lieu de pointer vers le vide.
MAIL_URL_APP=

# true → aucun envoi réel, le message est affiché dans la console du serveur.
# À utiliser en développement et pour les démonstrations hors ligne : sans lui,
# chaque test de création de compte écrit à une vraie adresse.
MAIL_DESACTIVE=false

# --- OCR des affiches de pharmacies de garde (Groq) ---
# Clé API : https://console.groq.com  (obligatoire, sinon l'OCR renvoie une erreur claire)
GROQ_API_KEY=

# Modèle vision. À changer si Groq retire celui-ci de son catalogue.
# Vérifier les modèles réellement accessibles : GET https://api.groq.com/openai/v1/models
GROQ_MODEL=qwen/qwen3.6-27b

# Plafond de tokens par réponse. Monter au-delà fait échouer l'offre gratuite
# ("Request too large") au lieu de rallonger le résultat.
GROQ_MAX_TOKENS=3000

# Prompt OCR. Laisser VIDE pour utiliser src/prompts/ocr-pharmacie-garde.txt
# (recommandé : pas d'échappement à gérer, et relu à chaque analyse).
# Si renseigné ici, cette valeur est prioritaire sur le fichier.
GROQ_OCR_PROMPT=

# Chemin d'un autre fichier de prompt, relatif à back-e-health/ (optionnel).
GROQ_OCR_PROMPT_FILE=
